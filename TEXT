infoBox("Step-by-step flow: User reports a found item", [
  "1. User fills out the ReportFoundItem form and clicks 'Submit'",
  "2. onSubmit() builds a FormData object (text fields + image file)",
  "3. createFoundItem(formData) calls axiosInstance.post('/found-items', formData)",
  "4. Request interceptor attaches 'Authorization: Bearer <token>' header",
  "5. Express receives POST /api/found-items — runs protect middleware (verifies JWT)",
  "6. upload.single('image') middleware: Multer uploads image to Cloudinary, attaches req.file",
  "7. foundItemController.createFoundItem() runs:",
  "   a. Extracts form fields from req.body",
  "   b. Builds keyword tags array from name + description",
  "   c. Creates FoundItem document in MongoDB via Mongoose",
  "   d. Calls matchItems(newItem, 'found') to find overlapping LostItem records",
  "   e. For each matching LostItem, creates a Notification document for the reporter",
  "8. Returns { success: true, data: newFoundItem } with 201 status",
  "9. React receives the response, navigates user to /my-reports",
  "10. Affected users see a notification badge on next page load or refresh",
], "E2F7F5", TEAL),
