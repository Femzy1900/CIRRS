// ─── CODE BLOCK BUILDER ───────────────────────────────────────────────────────
// Dark background code block using a 1-cell table
function codeBlock(lines, lang="") {
  const rows = [];
  // lang label row
  if (lang) {
    rows.push(new TableRow({ children:[ new TableCell({
      borders: noBdr,
      width:{ size:9360, type:WidthType.DXA },
      shading:{ fill:"2A2A3E", type:ShadingType.CLEAR },
      margins:{ top:60, bottom:0, left:180, right:180 },
      children:[new Paragraph({ children:[
        new TextRun({ text:lang, font:FONT, size:S10, color:"888888" })
      ]})]
    })]});
  }
  // code lines
  lines.forEach(line => {
    rows.push(new TableRow({ children:[ new TableCell({
      borders: noBdr,
      width:{ size:9360, type:WidthType.DXA },
      shading:{ fill:CODEBG, type:ShadingType.CLEAR },
      margins:{ top:0, bottom:0, left:180, right:180 },
      children:[new Paragraph({ children:[
        new TextRun({ text: line === "" ? " " : line, font:FONT, size:S10, color:CODEFG })
      ]})]
    })]});
  });
  // bottom padding row
  rows.push(new TableRow({ children:[ new TableCell({
    borders: noBdr,
    width:{ size:9360, type:WidthType.DXA },
    shading:{ fill:CODEBG, type:ShadingType.CLEAR },
    margins:{ top:0, bottom:60, left:180, right:180 },
    children:[new Paragraph({ children:[new TextRun({ text:" ", font:FONT, size:S10, color:CODEFG })] })]
  })]}));

  return new Table({
    width:{ size:9360, type:WidthType.DXA },
    columnWidths:[9360],
    margins:{ top:120, bottom:200 },
    rows
  });
}

// ─── INFO BOX ─────────────────────────────────────────────────────────────────
function infoBox(label, lines, fill, accent) {
  const children = [
    new Paragraph({ children:[new TextRun({ text:label, font:PROSE, size:S12, bold:true, color:accent })] }),
    ...lines.map(l => new Paragraph({
      numbering:{ reference:"bullets", level:0 },
      spacing:{ before:30, after:30 },
      children:[new TextRun({ text:l, font:PROSE, size:S11, color:"1E293B" })]
    }))
  ];
  return new Table({
    width:{ size:9360, type:WidthType.DXA }, columnWidths:[9360],
    rows:[new TableRow({ children:[new TableCell({
      borders: bAll(accent, 6),
      width:{ size:9360, type:WidthType.DXA },
      shading:{ fill, type:ShadingType.CLEAR },
      margins:{ top:120, bottom:120, left:200, right:200 },
      children
    })] })]
  });
}

// ─── SIMPLE TABLE ──────────────────────────────────────────────────────────────
function simpleTable(headers, rows, cws) {
  const totalW = cws.reduce((a,b)=>a+b,0);
  const hRow = new TableRow({ tableHeader:true, children: headers.map((h,i)=>
    new TableCell({
      borders: bAll("1A4A8A",4),
      width:{ size:cws[i], type:WidthType.DXA },
      shading:{ fill:NAVY, type:ShadingType.CLEAR },
      margins:{ top:80, bottom:80, left:120, right:120 },
      children:[new Paragraph({ alignment:AlignmentType.CENTER, children:[
        new TextRun({ text:h, font:PROSE, size:S11, bold:true, color:WHITE })
      ]})]
    })
  )});
  const dRows = rows.map((row, ri) =>
    new TableRow({ children: row.map((cell,ci) =>
      new TableCell({
        borders: bAll("CCCCCC",2),
        width:{ size:cws[ci], type:WidthType.DXA },
        shading:{ fill: ri%2===0 ? OFFWH : WHITE, type:ShadingType.CLEAR },
        margins:{ top:60, bottom:60, left:120, right:120 },
        children:[new Paragraph({ children:[
          new TextRun({ text:cell, font:PROSE, size:S11 })
        ]})]
      })
    )})
  );
  return new Table({ width:{ size:totalW, type:WidthType.DXA }, columnWidths:cws, rows:[hRow,...dRows] });
}

