h3("Controller  (server/controllers/claimController.js)"),
codeBlock([
  "const Claim        = require('../models/Claim');",
  "const FoundItem    = require('../models/FoundItem');",
  "const Notification = require('../models/Notification');",
  "const sendEmail    = require('../utils/sendEmail');",
  "",
  "// POST /api/claims",
  "exports.submitClaim = async (req, res, next) => {",
  "  try {",
  "    const { foundItemId, proofDescription } = req.body;",
  "    const existing = await Claim.findOne({ claimant: req.user._id, foundItem: foundItemId });",
  "    if (existing) return res.status(409).json({ message: 'Claim already submitted' });",
  "",
  "    const claim = await Claim.create({",
  "      claimant: req.user._id, foundItem: foundItemId, proofDescription",
  "    });",
  "",
  "    // Notify the finder that a claim was submitted",
  "    const foundItem = await FoundItem.findById(foundItemId).populate('finder');",
  "    await Notification.create({",
  "      recipient: foundItem.finder._id,",
  "      title: 'New Claim on Your Found Item',",
  "      message: `${req.user.fullName} has submitted a claim on '${foundItem.name}'.`,",
  "      type: 'claim_submitted', relatedId: claim._id,",
  "    });",
  "",
  "    res.status(201).json({ success: true, data: claim });",
  "  } catch (err) { next(err); }",
  "};",
  "",
  "// PUT /api/claims/:id/approve  (admin only)",
  "exports.approveClaim = async (req, res, next) => {",
  "  try {",
  "    const claim = await Claim.findById(req.params.id)",
  "      .populate('claimant foundItem');",
  "    if (!claim) return res.status(404).json({ message: 'Claim not found' });",
  "",
  "    claim.status     = 'approved';",
  "    claim.reviewedBy = req.user._id;",
  "    claim.reviewedAt = new Date();",
  "    await claim.save();",
  "",
  "    // Reveal finder contact on the found item",
  "    await FoundItem.findByIdAndUpdate(claim.foundItem._id,",
  "      { contactVisible: true, status: 'claimed' });",
  "",
  "    // Notify claimant",
  "    await Notification.create({",
  "      recipient: claim.claimant._id,",
  "      title: 'Claim Approved!',",
  "      message: `Your claim on '${claim.foundItem.name}' was approved. Contact the finder now.`,",
  "      type: 'claim_approved', relatedId: claim._id,",
  "    });",
  "",
  "    // Send email to claimant with finder details",
  "    const finder = await require('../models/User')",
  "      .findById(claim.foundItem.finder).select('fullName email phoneNumber');",
  "    await sendEmail({",
  "      to: claim.claimant.email,",
  "      subject: 'Your CIRRS Claim Was Approved',",
  "      html: `<h2>Claim Approved</h2>",
  "             <p>You can now contact the finder:</p>",
  "             <p><strong>${finder.fullName}</strong><br/>",
  "             Email: ${finder.email}<br/>",
  "             Phone: ${finder.phoneNumber || 'N/A'}</p>`,",
  "    });",
  "",
  "    res.json({ success: true, data: claim });",
  "  } catch (err) { next(err); }",
  "};",
  "",
  "// PUT /api/claims/:id/reject  (admin only)",
  "exports.rejectClaim = async (req, res, next) => {",
  "  try {",
  "    const claim = await Claim.findById(req.params.id).populate('claimant foundItem');",
  "    claim.status     = 'rejected';",
  "    claim.reviewedBy = req.user._id;",
  "    claim.reviewedAt = new Date();",
  "    claim.adminNote  = req.body.reason || '';",
  "    await claim.save();",
  "    await Notification.create({",
  "      recipient: claim.claimant._id,",
  "      title: 'Claim Rejected',",
  "      message: `Your claim on '${claim.foundItem.name}' was not approved.`,",
  "      type: 'claim_rejected', relatedId: claim._id,",
  "    });",
  "    res.json({ success: true, data: claim });",
  "  } catch (err) { next(err); }",
  "};",
  "",
  "exports.getMyClaims = async (req, res, next) => {",
  "  try {",
  "    const claims = await Claim.find({ claimant: req.user._id })",
  "      .populate('foundItem').sort({ createdAt: -1 });",
  "    res.json({ success: true, data: claims });",
  "  } catch (err) { next(err); }",
  "};",
  "",
  "exports.getAllClaims = async (req, res, next) => {",
  "  try {",
  "    const { status } = req.query;",
  "    const filter = status ? { status } : {};",
  "    const claims = await Claim.find(filter)",
  "      .populate('claimant foundItem reviewedBy').sort({ createdAt: -1 });",
  "    res.json({ success: true, data: claims });",
  "  } catch (err) { next(err); }",
  "};",
], "server/controllers/claimController.js"),
