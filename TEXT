h2("7.3  Item Matching Logic  (server/utils/matchItems.js)"),
body("The matching utility compares keyword tags between a newly created item and existing items of the opposite type, returning items that share at least 2 keyword overlaps. This drives the automated notification system."),
codeBlock([
  "const LostItem  = require('../models/LostItem');",
  "const FoundItem = require('../models/FoundItem');",
  "",
  "/**",
  " * @param {Object}  newItem   - The newly created LostItem or FoundItem document",
  " * @param {string}  type      - 'lost' | 'found'",
  " * @returns {Array}           - Array of matching documents from the opposite collection",
  " */",
  "const matchItems = async (newItem, type) => {",
  "  const Model   = type === 'lost' ? FoundItem : LostItem;",
  "  const filter  = {",
  "    category: newItem.category,",
  "    status:   type === 'lost' ? 'available' : 'open',",
  "    tags:     { $in: newItem.tags },",
  "  };",
  "  const candidates = await Model.find(filter).populate('reporter finder');",
  "",
  "  // Score by tag overlap — return matches with >= 2 shared tags",
  "  return candidates.filter(candidate => {",
  "    const overlap = candidate.tags.filter(t => newItem.tags.includes(t));",
  "    return overlap.length >= 2;",
  "  });",
  "};",
  "",
  "module.exports = { matchItems };",
], "server/utils/matchItems.js"),
