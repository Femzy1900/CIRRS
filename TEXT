h3("Controller  (server/controllers/lostItemController.js)"),
codeBlock([
  "const LostItem      = require('../models/LostItem');",
  "const FoundItem     = require('../models/FoundItem');",
  "const Notification  = require('../models/Notification');",
  "const { matchItems }= require('../utils/matchItems');",
  "",
  "// POST /api/lost-items",
  "exports.createLostItem = async (req, res, next) => {",
  "  try {",
  "    const { name, category, description, color, dateLost, locationLost } = req.body;",
  "    const tags = [...name.toLowerCase().split(' '),",
  "                  ...description.toLowerCase().split(' ').slice(0,10)];",
  "    const item = await LostItem.create({",
  "      reporter: req.user._id, name, category, description, color,",
  "      dateLost, locationLost, tags,",
  "      imageUrl: req.file ? req.file.path : '',",
  "    });",
  "",
  "    // Attempt to find matching found items and notify",
  "    const matches = await matchItems(item, 'lost');",
  "    for (const match of matches) {",
  "      await Notification.create({",
  "        recipient: req.user._id,",
  "        title: 'Potential Match Found',",
  "        message: `A found item '${match.name}' may match your report.`,",
  "        type: 'match', relatedId: match._id,",
  "      });",
  "    }",
  "    res.status(201).json({ success: true, data: item });",
  "  } catch (err) { next(err); }",
  "};",
  "",
  "// GET /api/lost-items  (with search + filter + pagination)",
  "exports.getAllLostItems = async (req, res, next) => {",
  "  try {",
  "    const { q, category, status, page = 1, limit = 12 } = req.query;",
  "    const filter = {};",
  "    if (q)        filter.$text = { $search: q };",
  "    if (category) filter.category = category;",
  "    if (status)   filter.status   = status;",
  "    const total = await LostItem.countDocuments(filter);",
  "    const items = await LostItem.find(filter)",
  "      .populate('reporter', 'fullName email')",
  "      .sort({ createdAt: -1 })",
  "      .skip((page - 1) * limit)",
  "      .limit(Number(limit));",
  "    res.json({ success: true, total, page: Number(page), data: items });",
  "  } catch (err) { next(err); }",
  "};",
  "",
  "// GET /api/lost-items/:id",
  "exports.getLostItemById = async (req, res, next) => {",
  "  try {",
  "    const item = await LostItem.findById(req.params.id)",
  "      .populate('reporter', 'fullName email phoneNumber');",
  "    if (!item) return res.status(404).json({ message: 'Item not found' });",
  "    res.json({ success: true, data: item });",
  "  } catch (err) { next(err); }",
  "};",
  "",
  "// GET /api/lost-items/mine",
